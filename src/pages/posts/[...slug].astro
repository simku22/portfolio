---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogDock from '../../components/BlogDock.astro';
import '../../../global.css';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post: CollectionEntry<'blog'>) => ({
        params: { slug: post.slug },
        props: post,
    }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout>
    <div class="min-h-screen px-4 md:px-[10%] pt-24 pb-28">
        <article class="max-w-4xl mx-auto">
            <div class="mb-8">
                <a
                    href={import.meta.env.BASE_URL || '/'}
                    class="return-home-btn group mb-6 inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-gray-200 dark:border-gray-700 bg-white/70 dark:bg-gray-800/60 backdrop-blur-sm text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:border-gray-300 dark:hover:border-gray-500 hover:shadow-sm transition-all"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="return-home-arrow transition-transform group-hover:-translate-x-0.5"
                    >
                        <path d="M19 12H5"></path>
                        <path d="M12 19l-7-7 7-7"></path>
                    </svg>
                    <span>Return Home</span>
                </a>
                <h1 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">
                    {post.data.title}
                </h1>
                <div
                    class="flex items-center flex-wrap gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400"
                >
                    <span class="font-medium text-gray-700 dark:text-gray-300"
                        >{post.data.author}</span
                    >
                    <span class="text-gray-300 dark:text-gray-600">·</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                        {
                            post.data.pubDate.toLocaleDateString('en-us', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                                timeZone: 'UTC',
                            })
                        }
                    </time>
                    {
                        post.data.tags && (
                            <div class="flex gap-2">
                                {post.data.tags.map((tag: string) => (
                                    <span class="bg-gray-100 dark:bg-gray-700 px-2 py-0.5 rounded text-xs">
                                        #{tag}
                                    </span>
                                ))}
                            </div>
                        )
                    }
                </div>
            </div>

            <div class="prose dark:prose-invert prose-lg max-w-none">
                <Content />
            </div>
        </article>
    </div>
    <BlogDock />
</Layout>

<style>
    /* Tailwind preflight resets headings to inherit body size/weight and no
       typography plugin is installed, so set heading scale by hand. Moderate
       sizes — clearly above body text without dominating. */
    :global(.prose h2) {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.01em;
        margin-top: 2em;
        margin-bottom: 0.6em;
    }
    :global(.prose h3) {
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.3;
        margin-top: 1.8em;
        margin-bottom: 0.5em;
    }
    :global(.prose h4) {
        font-size: 1rem;
        font-weight: 600;
        margin-top: 1.5em;
        margin-bottom: 0.4em;
    }
    :global(.prose p) {
        margin-bottom: 1.25em;
        line-height: 1.8;
    }
    :global(.prose li) {
        margin-top: 0.5em;
        margin-bottom: 0.5em;
    }

    /* Tailwind's preflight resets list markers/indentation and the Typography
       plugin isn't installed, so restore them by hand for markdown lists. */
    :global(.prose ul) {
        list-style: disc;
        padding-left: 1.5em;
        margin: 1.25em 0;
    }
    :global(.prose ol) {
        list-style: decimal;
        padding-left: 1.5em;
        margin: 1.25em 0;
    }
    :global(.prose ul ul) {
        list-style: circle;
        margin: 0.4em 0;
    }
    :global(.prose li::marker) {
        color: #9ca3af;
    }

    /* Inline code */
    :global(.prose :not(pre) > code) {
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
        font-size: 0.85em;
        background: #f3f4f6;
        color: #1f2937;
        padding: 0.1em 0.35em;
        border-radius: 0.25rem;
    }
    :global(.dark .prose :not(pre) > code) {
        background: rgba(55, 65, 81, 0.6);
        color: #e5e7eb;
    }

    /* Custom prose styles for better dark mode */
    :global(.prose) {
        color: #374151;
    }
    :global(.dark .prose) {
        color: #d1d5db;
    }
    :global(.prose h1, .prose h2, .prose h3, .prose h4) {
        color: #111827;
        font-family: 'DM Sans', sans-serif;
    }
    :global(.dark .prose h1, .dark .prose h2, .dark .prose h3, .dark .prose h4) {
        color: #f9fafb;
    }
    :global(.prose strong) {
        color: #111827;
    }
    :global(.dark .prose strong) {
        color: #f9fafb;
    }
    :global(.prose a) {
        color: #3b82f6;
    }
    :global(.dark .prose a) {
        color: #60a5fa;
    }
</style>
