---
// WeeksOfLife.astro
//
// A 77×52 grid of week-cells, one per week of a roughly 77-year life.
// Rendered as vanilla SVG so the "now" cell is recomputed live whenever the
// page loads — no build-time staleness and no d3 dependency. The grid is
// painted in three passes: cells (filled past/future, transparent for now),
// axis/decade scaffolding, then a single ring overlay on top of the now cell
// so its stroke isn't clipped by the neighbouring rects.
//
// Birth date is passed via data-birth so this component is reusable for
// anyone who wants their own grid; defaults to mine (April 29, 2004).
---

<figure class="weeks-fig">
    <div class="weeks-fig-header">
        <span class="weeks-fig-label">Figure 1 · Weeks of my life</span>
        <span class="weeks-fig-actions">
            <span class="weeks-fig-legend" data-legend-default>
                <span class="legend-item"
                    ><span class="swatch swatch-past" aria-hidden="true"></span>past</span
                >
                <span class="legend-item"
                    ><span class="swatch swatch-now" aria-hidden="true"></span>this week</span
                >
                <span class="legend-item"
                    ><span class="swatch swatch-future" aria-hidden="true"></span>ahead</span
                >
            </span>
            <span class="weeks-fig-legend weeks-fig-legend-gh" data-legend-gh aria-hidden="true">
                <span class="legend-item legend-gh-ramp" aria-label="less to more contributions">
                    less
                    <span class="gh-ramp">
                        <span class="gh-ramp-step" data-level="0"></span>
                        <span class="gh-ramp-step" data-level="1"></span>
                        <span class="gh-ramp-step" data-level="2"></span>
                        <span class="gh-ramp-step" data-level="3"></span>
                        <span class="gh-ramp-step" data-level="4"></span>
                    </span>
                    more
                </span>
                <span class="legend-item"
                    ><span class="swatch swatch-now" aria-hidden="true"></span>this week</span
                >
            </span>
            <button
                class="weeks-gh-toggle"
                type="button"
                aria-pressed="false"
                data-gh-toggle
                title="Overlay my GitHub contributions on this grid"
            >
                <svg class="weeks-gh-icon" viewBox="0 0 16 16" aria-hidden="true">
                    <path
                        fill="currentColor"
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                    ></path>
                </svg>
                <span class="weeks-gh-label">github</span>
            </button>
        </span>
    </div>

    <div
        class="weeks-host"
        data-weeks
        data-birth="2004-04-29"
        data-years="77"
        data-gh-user="simku22"
    >
        <svg
            class="weeks-svg"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-labelledby="weeks-title weeks-desc"
        >
            <title id="weeks-title">Weeks of my life</title>
            <desc id="weeks-desc"
                >A grid of weeks of an estimated 77-year life, one cell per week. The
                live "now" cell and exact counts are filled in by the page script.</desc
            >
        </svg>
        <div class="weeks-tooltip" role="status" aria-live="polite"></div>
    </div>

    <figcaption class="weeks-fig-caption">
        <span class="fig-num">Figure 1.</span>
        Each cell is one week of an estimated 77-year life. The ringed cell is the week I'm in
        right now — I was born April 29, 2004. The light cells haven't happened yet.
    </figcaption>
</figure>

<script>
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const WEEKS_PER_YEAR = 52;
    const MS_PER_WEEK = 1000 * 60 * 60 * 24 * 7;
    const MS_PER_DAY = 1000 * 60 * 60 * 24;

    type LiveCells = {
        ageYears: number;
        weeksIntoAge: number;
        idxNow: number;
    };

    function parseBirth(iso: string): Date {
        // Construct in local time so getDate/getMonth round-trip cleanly.
        // Using `new Date(iso)` would parse as UTC and shift by the local
        // offset for negative-UTC timezones.
        const [y, m, d] = iso.split('-').map((s) => parseInt(s, 10));
        return new Date(y, m - 1, d);
    }

    function liveCells(birth: Date, now: Date): LiveCells {
        // ageYears = whole years since birth in local time.
        let ageYears = now.getFullYear() - birth.getFullYear();
        const thisYearsBirthday = new Date(
            now.getFullYear(),
            birth.getMonth(),
            birth.getDate()
        );
        let lastBirthday: Date;
        if (now.getTime() < thisYearsBirthday.getTime()) {
            ageYears -= 1;
            lastBirthday = new Date(
                now.getFullYear() - 1,
                birth.getMonth(),
                birth.getDate()
            );
        } else {
            lastBirthday = thisYearsBirthday;
        }
        // Clamp to 51 so the now-marker can't fall on a non-existent 53rd
        // column of the 52-week grid (the real calendar carries 52 weeks +
        // ~1 day per year; the extra day eventually accumulates an extra
        // week, which we silently swallow).
        const weeksIntoAge = Math.min(
            WEEKS_PER_YEAR - 1,
            Math.floor((now.getTime() - lastBirthday.getTime()) / MS_PER_WEEK)
        );
        const idxNow = ageYears * WEEKS_PER_YEAR + weeksIntoAge;
        return { ageYears, weeksIntoAge, idxNow };
    }

    // Return the actual calendar year for the (age, weekOfAge) tooltip cell —
    // shifts mid-age-year so the value still reads sensibly when the cell
    // crosses Jan 1.
    function calendarYearFor(birth: Date, age: number, week: number): number {
        const startOfAge = new Date(
            birth.getFullYear() + age,
            birth.getMonth(),
            birth.getDate()
        );
        return new Date(startOfAge.getTime() + week * 7 * MS_PER_DAY).getFullYear();
    }

    function setAttrs(el: Element, attrs: Record<string, string | number>): void {
        for (const [k, v] of Object.entries(attrs)) {
            el.setAttribute(k, String(v));
        }
    }

    function makeRect(attrs: Record<string, string | number>): SVGRectElement {
        const r = document.createElementNS(SVG_NS, 'rect');
        setAttrs(r, attrs);
        return r;
    }

    function makeText(
        attrs: Record<string, string | number>,
        text: string
    ): SVGTextElement {
        const t = document.createElementNS(SVG_NS, 'text');
        setAttrs(t, attrs);
        t.textContent = text;
        return t;
    }

    function clear(node: Element): void {
        // Preserve <title> and <desc> so the SVG's accessible name survives
        // re-draws; everything else (cells, axis, ring) is rebuilt each tick.
        Array.from(node.children).forEach((child) => {
            const tag = child.tagName.toLowerCase();
            if (tag === 'title' || tag === 'desc') return;
            child.remove();
        });
    }

    // ── GitHub contribution overlay ────────────────────────────────
    // Per-host cache: avoids refetching when the user toggles on/off or the
    // grid is re-drawn (resize, view transition).
    const contribsCache = new WeakMap<HTMLElement, Map<string, number>>();

    function formatISO(d: Date): string {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }

    // Bucket weekly contribution totals into five levels. Tuned for daily-data
    // summed over 7 days: roughly "a handful", "a week of work", "heavy", "rip".
    function levelFor(count: number): number {
        if (count <= 0) return 0;
        if (count <= 7) return 1;
        if (count <= 20) return 2;
        if (count <= 49) return 3;
        return 4;
    }

    type ProbeResp = {
        total?: Record<string, number>;
        contributions?: Array<{ date: string; count: number }>;
    };

    // Pull all years jogruber's v4 API knows about for this user. The probe
    // (no `y=` param) returns the current year's daily series PLUS a `total`
    // map keyed by every year the user has contributions in. We then fan out
    // to grab the other years in parallel.
    async function loadAllContribs(user: string): Promise<Map<string, number>> {
        const base = `https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(user)}`;
        const probe = (await fetch(base).then((r) => {
            if (!r.ok) throw new Error(`probe ${r.status}`);
            return r.json();
        })) as ProbeResp;

        const map = new Map<string, number>();
        for (const c of probe.contributions || []) map.set(c.date, c.count);

        const years = Object.keys(probe.total || {})
            .map((s) => parseInt(s, 10))
            .filter((y) => !isNaN(y))
            .sort();
        const probeYear = probe.contributions?.[0]?.date?.slice(0, 4) ?? '';
        const remaining = years.filter((y) => String(y) !== probeYear);

        if (remaining.length > 0) {
            const results = await Promise.all(
                remaining.map((y) =>
                    fetch(`${base}?y=${y}`)
                        .then((r) => (r.ok ? (r.json() as Promise<ProbeResp>) : null))
                        .catch(() => null)
                )
            );
            for (const r of results) {
                if (!r) continue;
                for (const c of r.contributions || []) map.set(c.date, c.count);
            }
        }

        return map;
    }

    // Anchor each cell to a real calendar week by re-applying the birthday
    // shift per age-year. Doing `birth + idx*7 days` would drift by ~1.25
    // days per year (52 weeks = 364 days, not 365.25), so by age 22 the
    // "now" cell would be looking up contributions from ~a month ago.
    function cellStartDate(birth: Date, age: number, weekOfAge: number): Date {
        const startOfAge = new Date(
            birth.getFullYear() + age,
            birth.getMonth(),
            birth.getDate()
        );
        return new Date(startOfAge.getTime() + weekOfAge * 7 * 86400000);
    }

    // Walk every past cell AND the now-cell in the SVG, sum the 7 days
    // starting at that life-week's actual calendar start, and stamp
    // data-level + data-contribs. The now-cell only contributes a partial
    // week so far, but the tooltip's contribs row should still reflect what
    // has been logged. The .now cell's fill is unaffected — CSS only targets
    // .past[data-level].
    function applyContribLevels(
        host: HTMLElement,
        birth: Date,
        contribs: Map<string, number>
    ): void {
        const cells = host.querySelectorAll<SVGRectElement>(
            '.weeks-cell.past, .weeks-cell.now'
        );
        const todayIso = formatISO(new Date());
        for (const cell of cells) {
            const age = parseInt(cell.getAttribute('data-age') || '0', 10);
            const weekOfAge = parseInt(cell.getAttribute('data-week') || '0', 10);
            const weekStart = cellStartDate(birth, age, weekOfAge);
            let count = 0;
            let hasAny = false;
            for (let d = 0; d < 7; d++) {
                const day = new Date(weekStart.getTime() + d * 86400000);
                const iso = formatISO(day);
                // Don't count days in the future for the in-progress current
                // week — they exist in the API as 0 but we shouldn't claim
                // coverage for them.
                if (iso > todayIso) break;
                if (contribs.has(iso)) {
                    count += contribs.get(iso) as number;
                    hasAny = true;
                }
            }
            if (hasAny) {
                cell.setAttribute('data-level', String(levelFor(count)));
                cell.setAttribute('data-contribs', String(count));
            }
        }
    }

    function bindGhToggle(host: HTMLElement): void {
        const figure = host.closest('.weeks-fig');
        if (!figure) return;
        const btn = figure.querySelector<HTMLButtonElement>('[data-gh-toggle]');
        if (!btn || btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';

        btn.addEventListener('click', async () => {
            if (btn.classList.contains('is-loading')) return;
            const pressed = btn.getAttribute('aria-pressed') === 'true';

            if (pressed) {
                btn.setAttribute('aria-pressed', 'false');
                host.classList.remove('show-contribs');
                return;
            }

            // First press: lazy-fetch (or use cached data).
            if (!contribsCache.has(host)) {
                btn.classList.remove('is-error');
                btn.classList.add('is-loading');
                btn.setAttribute('aria-busy', 'true');
                try {
                    const user = host.dataset.ghUser || 'simku22';
                    const data = await loadAllContribs(user);
                    contribsCache.set(host, data);
                } catch (err) {
                    console.warn('weeks: github contributions fetch failed', err);
                    btn.classList.remove('is-loading');
                    btn.classList.add('is-error');
                    btn.removeAttribute('aria-busy');
                    btn.title = "Couldn't load GitHub contributions";
                    return;
                }
                btn.classList.remove('is-loading');
                btn.removeAttribute('aria-busy');
            }

            const birth = parseBirth(host.dataset.birth || '2004-04-29');
            applyContribLevels(host, birth, contribsCache.get(host) as Map<string, number>);
            btn.setAttribute('aria-pressed', 'true');
            host.classList.add('show-contribs');
        });
    }

    function describeLive(
        svg: SVGSVGElement,
        ageYears: number,
        weeksIntoAge: number,
        pastCount: number,
        futureCount: number,
        total: number
    ): void {
        const desc = svg.querySelector('desc');
        if (!desc) return;
        // Numeric formatting with thousands separator for readability.
        const fmt = (n: number) => n.toLocaleString('en-US');
        desc.textContent =
            `Each cell is one week of an estimated ${fmt(total / 52)}-year life. ` +
            `I'm currently ${ageYears} years old, week ${weeksIntoAge + 1} of the year. ` +
            `${fmt(pastCount)} weeks lived, ${fmt(futureCount)} ahead — ` +
            `${fmt(total)} total.`;
    }

    function draw(host: HTMLElement): void {
        const svg = host.querySelector<SVGSVGElement>('.weeks-svg');
        const tooltip = host.querySelector<HTMLDivElement>('.weeks-tooltip');
        if (!svg || !tooltip) return;

        const birth = parseBirth(host.dataset.birth || '2004-04-29');
        const years = parseInt(host.dataset.years || '77', 10);
        const now = new Date();
        const { ageYears, weeksIntoAge, idxNow } = liveCells(birth, now);
        const totalCells = years * WEEKS_PER_YEAR;
        describeLive(svg, ageYears, weeksIntoAge, idxNow, totalCells - idxNow - 1, totalCells);

        // Layout: leave room for y-axis labels on the left, x-axis labels on
        // the top, and an axis title underneath.
        const W = host.clientWidth || 600;
        const padL = 30;
        const padR = 6;
        const padT = 18;
        const padB = 22;
        const gap = 2;
        const innerW = Math.max(0, W - padL - padR);
        const cell = Math.max(2, (innerW - (WEEKS_PER_YEAR - 1) * gap) / WEEKS_PER_YEAR);
        const gridH = years * cell + (years - 1) * gap;
        const H = gridH + padT + padB;

        setAttrs(svg, {
            width: W,
            height: H,
            viewBox: `0 0 ${W} ${H}`,
        });
        clear(svg);

        // ── Cells ────────────────────────────────────────────────────
        const cellGroup = document.createElementNS(SVG_NS, 'g');
        cellGroup.setAttribute('class', 'weeks-cells');
        let nowRect: SVGRectElement | null = null;
        for (let age = 0; age < years; age++) {
            for (let w = 0; w < WEEKS_PER_YEAR; w++) {
                const idx = age * WEEKS_PER_YEAR + w;
                const x = padL + w * (cell + gap);
                const y = padT + age * (cell + gap);
                const cls =
                    idx === idxNow
                        ? 'weeks-cell now'
                        : idx < idxNow
                          ? 'weeks-cell past'
                          : 'weeks-cell future';
                const rect = makeRect({
                    x,
                    y,
                    width: cell,
                    height: cell,
                    class: cls,
                    'data-idx': idx,
                    'data-age': age,
                    'data-week': w,
                });
                if (idx === idxNow) nowRect = rect;
                cellGroup.appendChild(rect);
            }
        }
        svg.appendChild(cellGroup);

        // ── Decade lines + age labels ──────────────────────────────
        const axisGroup = document.createElementNS(SVG_NS, 'g');
        axisGroup.setAttribute('class', 'weeks-axis');
        for (let d = 0; d <= years; d += 10) {
            // Skip the divider line at 0 and at years (the grid edges); keep
            // labels on every decade including 0.
            if (d > 0 && d < years) {
                const ly = padT + d * (cell + gap) - gap / 2;
                const line = document.createElementNS(SVG_NS, 'line');
                setAttrs(line, {
                    x1: padL,
                    y1: ly,
                    x2: padL + innerW,
                    y2: ly,
                    class: 'weeks-decade-line',
                });
                axisGroup.appendChild(line);
            }
            axisGroup.appendChild(
                makeText(
                    {
                        x: padL - 6,
                        y: padT + d * (cell + gap) + cell * 0.7,
                        class: 'weeks-axis-text',
                        'text-anchor': 'end',
                    },
                    String(d)
                )
            );
        }

        // ── Month labels along the top ─────────────────────────────
        const months = [
            { w: 0, t: 'jan' },
            { w: 13, t: 'apr' },
            { w: 26, t: 'jul' },
            { w: 39, t: 'oct' },
            { w: 51, t: 'dec' },
        ];
        for (const m of months) {
            axisGroup.appendChild(
                makeText(
                    {
                        x: padL + m.w * (cell + gap) + cell / 2,
                        y: padT - 5,
                        class: 'weeks-axis-text',
                        'text-anchor': 'middle',
                    },
                    m.t
                )
            );
        }

        // ── Axis titles ────────────────────────────────────────────
        axisGroup.appendChild(
            makeText(
                {
                    x: padL + innerW / 2,
                    y: H - 5,
                    class: 'weeks-axis-title',
                    'text-anchor': 'middle',
                },
                'week of year'
            )
        );
        const yTitleX = 10;
        const yTitleY = padT + gridH / 2;
        const yTitle = makeText(
            {
                x: yTitleX,
                y: yTitleY,
                class: 'weeks-axis-title',
                'text-anchor': 'middle',
                transform: `rotate(-90 ${yTitleX} ${yTitleY})`,
            },
            'age'
        );
        axisGroup.appendChild(yTitle);
        svg.appendChild(axisGroup);

        // Re-apply GitHub contribution levels if the user has already loaded
        // them (e.g. on resize or view-transition re-render).
        const cachedContribs = contribsCache.get(host);
        if (cachedContribs) {
            applyContribLevels(host, birth, cachedContribs);
        }

        // ── Now-ring overlay (drawn on top so neighbours can't clip it) ──
        if (nowRect) {
            const x = parseFloat(nowRect.getAttribute('x')!);
            const y = parseFloat(nowRect.getAttribute('y')!);
            const inset = 0.75;
            const ring = makeRect({
                x: x + inset,
                y: y + inset,
                width: cell - 2 * inset,
                height: cell - 2 * inset,
                class: 'weeks-now-ring',
            });
            svg.appendChild(ring);
        }

        // ── Hover (delegated; tooltip lives inside the host) ──────
        const TT_W_FALLBACK = 116;
        const onMove = (e: MouseEvent) => {
            const target = e.target as Element;
            const idxAttr = target.getAttribute?.('data-idx');
            if (idxAttr === null || idxAttr === undefined) {
                tooltip.style.opacity = '0';
                return;
            }
            const age = parseInt(target.getAttribute('data-age') || '0', 10);
            const wk = parseInt(target.getAttribute('data-week') || '0', 10);
            const calYear = calendarYearFor(birth, age, wk);

            const rect = host.getBoundingClientRect();
            const ttW = tooltip.offsetWidth || TT_W_FALLBACK;
            const ttH = tooltip.offsetHeight || 56;
            const rawX = e.clientX - rect.left + 14;
            const rawY = e.clientY - rect.top + 14;
            const tx = Math.max(0, Math.min(rawX, host.clientWidth - ttW - 4));
            const ty = Math.max(0, Math.min(rawY, host.clientHeight - ttH - 4));

            tooltip.style.left = `${tx}px`;
            tooltip.style.top = `${ty}px`;
            tooltip.style.opacity = '1';
            const ghOn = host.classList.contains('show-contribs');
            const contribAttr = target.getAttribute('data-contribs');
            const contribRow =
                ghOn && contribAttr !== null
                    ? `<div class="tt-row"><span class="tt-key">contribs</span><span class="tt-val">${contribAttr}</span></div>`
                    : '';
            tooltip.innerHTML = `
                <div class="tt-row"><span class="tt-key">age</span><span class="tt-val">${age}</span></div>
                <div class="tt-row"><span class="tt-key">year</span><span class="tt-val">${calYear}</span></div>
                <div class="tt-row"><span class="tt-key">week</span><span class="tt-val">${wk + 1}</span></div>
                ${contribRow}
            `;
        };
        const onLeave = () => {
            tooltip.style.opacity = '0';
        };

        // Replace previous listeners (boot can re-fire on view transitions).
        svg.onmousemove = onMove;
        svg.onmouseleave = onLeave;
    }

    function debounce<T extends (...args: never[]) => void>(fn: T, ms: number): T {
        let t: number | undefined;
        return ((...args: never[]) => {
            if (t !== undefined) window.clearTimeout(t);
            t = window.setTimeout(() => fn(...args), ms);
        }) as T;
    }

    const observers = new WeakMap<HTMLElement, ResizeObserver>();

    function boot() {
        document.querySelectorAll<HTMLElement>('[data-weeks]').forEach((host) => {
            draw(host);
            // Reuse one observer per host across view transitions.
            if (!observers.has(host)) {
                const ro = new ResizeObserver(debounce(() => draw(host), 100));
                ro.observe(host);
                observers.set(host, ro);
            }
            bindGhToggle(host);
        });
    }

    boot();
    document.addEventListener('astro:page-load', boot);
</script>
