---
// ExperienceSection.astro - Expandable experience & projects with card-based design
import { Image } from 'astro:assets';
import amazonLogo from '../assets/amazon.svg';
---

<div class="experience-section">
    <!-- Expandable Header -->
    <button id="experience-toggle" class="experience-header" aria-expanded="false">
        <svg
            id="toggle-arrow"
            class="toggle-arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M6 9l6 6 6-6"></path>
        </svg>
        <span class="header-text">Experience & Projects</span>
    </button>

    <!-- Expandable Content -->
    <div id="experience-content" class="experience-content">
        <div class="experience-inner">

            <!-- Work Experience -->
            <div class="cards-group">
                <div class="group-label">Work</div>
                <div class="card">
                    <div class="card-top">
                        <div class="card-logo">
                            <Image src={amazonLogo} alt="Amazon" class="logo-img amazon-logo" />
                        </div>
                        <div class="card-meta">
                            <div class="card-title-row">
                                <span class="card-company">Amazon</span>
                                <span class="card-date">Nov 2023 – Present</span>
                            </div>
                            <span class="card-role">Software Engineer Intern (Year-Round)</span>
                            <div class="card-tags">
                                <span class="tag">AWS</span>
                                <span class="tag">TypeScript</span>
                                <span class="tag">Java</span>
                                <span class="tag">Kotlin</span>
                            </div>
                        </div>
                    </div>
                    <ul class="card-bullets">
                        <li>
                            Migrated a Lambda-based file processing service to Fargate with Java 21
                            and virtual threads, implementing streaming I/O to process terabytes of
                            data with minimal memory during a petabyte-scale migration of billions
                            of files.
                        </li>
                        <li>
                            Built a workflow observability dashboard for global book publishing with
                            React and Lambda, providing real-time failure diagnostics that
                            eliminated cross-system investigation for 25% of on-call tickets.
                        </li>
                        <li>
                            Replaced 5 manually-scaled CloudSearch domains with serverless
                            OpenSearch using a DynamoDB Streams pipeline, reducing total storage by
                            66% through document consolidation with upsert operations.
                        </li>
                        <li>
                            Embedded debugging tools into a legacy JSP dashboard, consolidating
                            cross-region checks into a single interface that eliminated 40+ seconds
                            of navigation per incident.
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Projects -->
            <div class="cards-group">
                <div class="group-label">Projects</div>

                <div class="card">
                    <div class="card-top">
                        <div class="card-meta">
                            <div class="card-title-row">
                                <div class="card-company-group">
                                    <span class="card-company">Cvrve</span>
                                    <a href="https://cvrve.me/" target="_blank" class="project-link">cvrve.me ↗</a>
                                </div>
                                <span class="card-date">March 2025</span>
                            </div>
                            <div class="card-tags">
                                <span class="tag">EC2</span>
                                <span class="tag">DuckDB</span>
                                <span class="tag">PostgreSQL</span>
                                <span class="tag">TypeScript</span>
                                <span class="tag">Express</span>
                            </div>
                        </div>
                    </div>
                    <ul class="card-bullets">
                        <li>
                            Created a bot that streamed 2000+ job postings to over 150,000 total
                            users in SWE-related discord servers for UW, USC, UCI, and more.
                        </li>
                        <li>
                            Built a URL-shortening and analytics service handling 5M+ total clicks
                            with 70K daily peak traffic using Express, DuckDB, EC2, and PostgreSQL
                            on a fully free-tier stack.
                        </li>
                        <li>
                            Developed a headless-browser crawler to classify closed job links with
                            95%+ accuracy, capture screenshots, and create pull requests using
                            Puppeteer and the GitHub API.
                        </li>
                    </ul>
                </div>

                <div class="card">
                    <div class="card-top">
                        <div class="card-meta">
                            <div class="card-title-row">
                                <span class="card-company">Willow</span>
                                <span class="card-date">June 2025</span>
                            </div>
                            <div class="card-tags">
                                <span class="tag">LangChain</span>
                                <span class="tag">Gemini</span>
                                <span class="tag">Postfix</span>
                                <span class="tag">RabbitMQ</span>
                                <span class="tag">Firebase</span>
                                <span class="tag">TypeScript</span>
                                <span class="tag">Python</span>
                            </div>
                        </div>
                    </div>
                    <ul class="card-bullets">
                        <li>
                            Lead a team of 2 developers over a 6-month capstone to build a job-mail
                            classification service.
                        </li>
                        <li>
                            Hosted Postfix and RabbitMQ on an EC2 instance to create a data
                            pipeline, with LangChain and Gemini 2.0 to extract structured job
                            statuses (e.g. rejection, interviews) from raw email data.
                        </li>
                        <li>
                            Implemented full-stack security using Firebase's authentication service
                            and displayed classification results on a React dashboard polling from
                            Firestore.
                        </li>
                    </ul>
                </div>

                <div class="card">
                    <div class="card-top">
                        <div class="card-meta">
                            <div class="card-title-row">
                                <span class="card-company">Traffic Light Optimization</span>
                                <span class="card-date">June 2025</span>
                            </div>
                            <div class="card-tags">
                                <span class="tag">Python</span>
                                <span class="tag">Numpy</span>
                                <span class="tag">Matplotlib</span>
                                <span class="tag">LaTeX</span>
                            </div>
                        </div>
                    </div>
                    <ul class="card-bullets">
                        <li>
                            Engineered a cellular automata–based traffic flow simulator and applied
                            dual annealing to optimize light cycles.
                        </li>
                        <li>
                            Modeled agent traffic through a DAG using Poisson-distributed spawning,
                            efficient topological sorting, and linear shortest-path routing.
                        </li>
                    </ul>
                </div>

                <div class="card">
                    <div class="card-top">
                        <div class="card-meta">
                            <div class="card-title-row">
                                <span class="card-company">Attendance Tracker</span>
                                <span class="card-date">June 2024</span>
                            </div>
                            <div class="card-tags">
                                <span class="tag">Azure</span>
                                <span class="tag">React</span>
                                <span class="tag">Tailwind</span>
                                <span class="tag">ShadCN</span>
                                <span class="tag">MySQL</span>
                            </div>
                        </div>
                    </div>
                    <ul class="card-bullets">
                        <li>
                            Built a streamlined attendance management system with Azure, React, and
                            ShadCN, enabling easy event creation and attendance tracking via QR
                            codes.
                        </li>
                        <li>
                            Designed a RESTful backend with Express using WebSockets and MySQL for
                            real-time event joining and storage.
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function initExperienceSection() {
        const toggle = document.getElementById('experience-toggle');
        const content = document.getElementById('experience-content');
        const arrow = document.getElementById('toggle-arrow');

        if (!toggle || !content || !arrow) return;

        // Clean up previous listeners if re-initializing
        const newToggle = toggle.cloneNode(true) as HTMLElement;
        toggle.parentNode?.replaceChild(newToggle, toggle);

        let isExpanded = false;

        newToggle.addEventListener('click', () => {
            isExpanded = !isExpanded;
            newToggle.setAttribute('aria-expanded', String(isExpanded));

            if (isExpanded) {
                content.classList.add('is-expanded');
                arrow.classList.add('is-rotated');
            } else {
                content.classList.remove('is-expanded');
                arrow.classList.remove('is-rotated');
            }
        });
    }

    // Initialize
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initExperienceSection);
    } else {
        initExperienceSection();
    }

    document.addEventListener('astro:page-load', initExperienceSection);
</script>

<style>
    /* ── Section container ── */
    .experience-section {
        width: 100%;
    }

    /* ── Toggle header ── */
    .experience-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0;
        background: transparent;
        border: none;
        cursor: pointer;
        transition: opacity 0.2s ease;
    }

    .experience-header:hover {
        opacity: 0.75;
    }

    .toggle-arrow {
        flex-shrink: 0;
        color: #9ca3af;
        transition:
            color 0.2s ease,
            transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .toggle-arrow.is-rotated {
        transform: rotate(180deg);
    }

    .experience-header:hover .toggle-arrow {
        color: #6b7280;
    }

    .header-text {
        font-size: 1.125rem;
        font-weight: 600;
        color: #1f2937;
    }

    /* ── Expandable wrapper (grid trick for smooth height) ── */
    .experience-content {
        display: grid;
        grid-template-rows: 0fr;
        padding-top: 0;
        opacity: 0;
        overflow: hidden;
        transition:
            grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.3s ease-out,
            padding-top 0.3s ease;
    }

    .experience-content.is-expanded {
        grid-template-rows: 1fr;
        opacity: 1;
        padding-top: 1rem;
    }

    .experience-inner {
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    /* ── Group labels (Work / Projects) ── */
    .cards-group {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .group-label {
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #9ca3af;
        padding-left: 0.125rem;
    }

    /* ── Card ── */
    .card {
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 1rem 1.125rem;
        background: #ffffff;
        transition:
            transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            border-color 0.25s ease;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
        border-color: #d1d5db;
    }

    /* ── Card top row: logo + meta ── */
    .card-top {
        display: flex;
        align-items: flex-start;
        gap: 0.875rem;
    }

    .card-logo {
        flex-shrink: 0;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 0.5rem;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-top: 0.125rem;
    }

    .logo-img {
        width: 1.75rem;
        height: auto;
        object-fit: contain;
    }

    .amazon-logo {
        width: 1.5rem;
    }

    .card-icon {
        flex-shrink: 0;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 0.5rem;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        margin-top: 0.125rem;
    }

    /* ── Meta (title row, role, tags) ── */
    .card-meta {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .card-title-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .card-company-group {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .card-company {
        font-size: 0.9375rem;
        font-weight: 600;
        color: #111827;
    }

    .card-date {
        font-size: 0.8125rem;
        color: #9ca3af;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .card-role {
        font-size: 0.8125rem;
        font-style: italic;
        color: #6b7280;
    }

    .project-link {
        font-size: 0.8125rem;
        color: #3b82f6;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .project-link:hover {
        color: #2563eb;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    /* ── Tech tags ── */
    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3125rem;
        margin-top: 0.125rem;
    }

    .tag {
        font-size: 0.6875rem;
        font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
        color: #6b7280;
        background: #f3f4f6;
        padding: 0.125rem 0.4375rem;
        border-radius: 0.25rem;
        letter-spacing: 0.01em;
        line-height: 1.4;
    }

    /* ── Bullet list ── */
    .card-bullets {
        margin: 0.625rem 0 0 0;
        padding-left: 1.125rem;
        list-style-type: disc;
    }

    .card-bullets li {
        font-size: 0.8125rem;
        color: #4b5563;
        line-height: 1.55;
        margin-bottom: 0.3125rem;
    }

    .card-bullets li:last-child {
        margin-bottom: 0;
    }

    .card-bullets li::marker {
        color: #d1d5db;
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
        .card-title-row {
            flex-direction: column;
            gap: 0.125rem;
        }

        .card-top {
            gap: 0.625rem;
        }

        .card-logo,
        .card-icon {
            width: 2rem;
            height: 2rem;
        }

        .logo-img {
            width: 1.5rem;
        }

        .amazon-logo {
            width: 1.25rem;
        }
    }

    /* ═══════════════ Dark mode ═══════════════ */
    :global(.dark) .header-text {
        color: #f9fafb;
    }

    :global(.dark) .toggle-arrow {
        color: #6b7280;
    }

    :global(.dark) .experience-header:hover .toggle-arrow {
        color: #9ca3af;
    }

    :global(.dark) .group-label {
        color: #6b7280;
    }

    :global(.dark) .card {
        background: rgba(31, 41, 55, 0.5);
        border-color: #374151;
    }

    :global(.dark) .card:hover {
        border-color: #4b5563;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    :global(.dark) .card-logo {
        background: rgba(55, 65, 81, 0.6);
        border-color: #4b5563;
    }

    :global(.dark) .card-icon {
        background: rgba(55, 65, 81, 0.6);
        border-color: #4b5563;
        color: #9ca3af;
    }

    :global(.dark) .card-company {
        color: #f9fafb;
    }

    :global(.dark) .card-date {
        color: #6b7280;
    }

    :global(.dark) .card-role {
        color: #9ca3af;
    }

    :global(.dark) .tag {
        background: rgba(55, 65, 81, 0.5);
        color: #9ca3af;
    }

    :global(.dark) .card-bullets li {
        color: #d1d5db;
    }

    :global(.dark) .card-bullets li::marker {
        color: #4b5563;
    }

    :global(.dark) .project-link {
        color: #60a5fa;
    }

    :global(.dark) .project-link:hover {
        color: #93c5fd;
    }

    :global(.dark) .amazon-logo {
        filter: brightness(0) invert(1);
    }
</style>
