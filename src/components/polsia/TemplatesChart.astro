---
// TemplatesChart — top-20 phrase openers by occurrence. Independent of the
// map filter. Data: templates.json.
---

<div class="polsia-fig">
    <div data-templates>
        <!-- 20 rows × 18 + 40 = 400, matching the rendered chart height -->
        <div class="polsia-loading" style="height:400px">loading templates…</div>
    </div>
</div>

<script>
    import * as Plot from '@observablehq/plot';
    import { loadJSON, makeChart, plotStyle } from '../../lib/polsia-charts.js';

    async function init(host) {
        const tpl = (await loadJSON('templates.json')).slice(0, 20);

        makeChart(
            host,
            (width) =>
                Plot.plot({
                    width,
                    height: Math.max(220, tpl.length * 18 + 40),
                    marginLeft: 110,
                    style: plotStyle(),
                    x: { label: 'occurrences', grid: true },
                    y: { label: null },
                    marks: [
                        Plot.barX(tpl, {
                            x: 'count',
                            y: 'template',
                            fill: 'var(--polsia-fg-fainter)',
                            sort: { y: 'x', reverse: true },
                        }),
                        Plot.text(tpl, {
                            x: 'count',
                            y: 'template',
                            text: 'count',
                            dx: 4,
                            fontSize: 10,
                            textAnchor: 'start',
                            fill: 'var(--polsia-fg-muted)',
                        }),
                        Plot.ruleX([0]),
                    ],
                }),
            { onTheme: true }
        );
    }

    function boot() {
        document.querySelectorAll('[data-templates]').forEach((host) => {
            if (host.dataset.ready) return;
            host.dataset.ready = '1';
            init(host).catch((err) => {
                host.innerHTML =
                    '<div class="polsia-loading" style="height:400px">couldn’t load templates</div>';
                console.error(err);
            });
        });
    }

    boot();
    document.addEventListener('astro:page-load', boot);
</script>
