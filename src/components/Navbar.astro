---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');
---

<nav class="fixed top-8 left-1/2 -translate-x-1/2 z-50">
    <div class="flex items-center gap-4 px-6 py-3">
        <a href={import.meta.env.BASE_URL} aria-label="Home Page" class="group">
            <div
                class={`w-3 h-3 rounded-full transition-all duration-300 ${currentPath === import.meta.env.BASE_URL || currentPath === import.meta.env.BASE_URL.slice(0, -1) ? 'bg-black dark:bg-white scale-110' : 'bg-gray-300 dark:bg-gray-600 hover:bg-gray-400 dark:hover:bg-gray-500'}`}
            >
            </div>
        </a>
        <a href={`${import.meta.env.BASE_URL}blog`} aria-label="Blog Page" class="group">
            <div
                class={`w-3 h-3 rounded-full transition-all duration-300 ${currentPath.includes('/blog') || currentPath.includes('/posts') ? 'bg-black dark:bg-white scale-110' : 'bg-gray-300 dark:bg-gray-600 hover:bg-gray-400 dark:hover:bg-gray-500'}`}
            >
            </div>
        </a>
    </div>
</nav>
